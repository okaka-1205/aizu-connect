rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userRef(uid) {
      return firestore.get(
        /databases/(default)/documents/users/$(uid)
      );
    }

    function activeUserData(data, roles) {
      return data.status == 'active' && data.role in roles;
    }

    function activeCreator(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && activeUserData(userRef(uid).data, ['student', 'organization']);
    }

    function verifiedAdminSecondFactor() {
      return (
        request.auth.token.firebase is map
        && request.auth.token.firebase.keys().hasAll(['sign_in_second_factor'])
        && request.auth.token.firebase.sign_in_second_factor == 'totp'
      ) || (
        request.auth.token.keys().hasAll(['aud', 'test_admin_mfa'])
        && request.auth.token.test_admin_mfa == true
        && request.auth.token.aud in [
          'demo-aizu-connect-admin-approval', 'demo-aizu-connect-e2e',
          'demo-aizu-connect-a11y', 'demo-aizu-connect-local'
        ]
      );
    }

    function validFileReader(data) {
      return data.status == 'active' && (
        data.role in ['student', 'organization']
        || (data.role == 'admin' && verifiedAdminSecondFactor())
      );
    }

    function activeFileReader() {
      return signedIn()
        && request.auth.token.email_verified == true
        && validFileReader(userRef(request.auth.uid).data);
    }

    function reportOwner(data, ownerId) {
      return data.createdBy == ownerId && data.status != 'deleting';
    }

    function validImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /profile-images/{userId}/{fileName} {
      allow read: if activeFileReader();
      allow write: if activeCreator(userId) && validImage();
    }

    match /event-images/{organizationId}/{eventId}/{fileName} {
      allow read: if activeFileReader();
      allow write: if activeCreator(organizationId)
        && !firestore.exists(/databases/(default)/documents/deletionLocks/$('event_' + eventId))
        && validImage();
    }

    match /event-reports/{organizationId}/{eventId}/{fileName} {
      allow read: if activeFileReader();
      allow write: if activeCreator(organizationId)
        && reportOwner(firestore.get(
          /databases/(default)/documents/events/$(eventId)
        ).data, organizationId)
        && validImage();
    }

    // Upload and attachment metadata are authorized by the callable. The app
    // displays the same tokenized URLs as before; no client Storage RPC is used.
    match /chat-attachments/{path=**} {
      allow read, write: if false;
    }
  }
}
