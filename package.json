{
  "name": "aizu-connect",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "check": "npm run lint && npm run build && npm --prefix functions run lint && npm --prefix functions run build",
