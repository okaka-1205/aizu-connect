rules_version = '2';

// Assumed data model and trust boundaries:
// - users/studentProfiles/organizations: private identity and review records.
// - legalConsents/thirdPartyProvisionLogs: immutable compliance records.
// - events/eventApplications/activities: server-created workflow records.
// - chatRooms/{roomId}/messages|reads: participant-scoped communication.
// - notifications/preferences/savedEvents/savedSearches: owner-scoped data.
// - reports/auditLogs/accountDeletionRequests: moderated operational records.
// - publicOrganizerProfiles: authenticated public projection without private PII.
// - eventCheckIns/checkInAttempts/functionReceipts/adminOperations:
//   server-owned operational state; clients cannot write attempt/receipt data.
// All unmatched paths are denied at the end of this file.

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userRef(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasUser() {
      return signedIn() && exists(userRef(request.auth.uid));
    }

    function userData() {
      return get(userRef(request.auth.uid)).data;
    }

    function hasActiveRole(roles) {
      return hasUser()
        && userData().role in roles
        && userData().status == 'active'
        && request.auth.token.email_verified == true;
    }

    function hasVerifiedAdminSecondFactor() {
      return (
        request.auth.token.firebase is map
        && request.auth.token.firebase.keys().hasAll(['sign_in_second_factor'])
        && request.auth.token.firebase.sign_in_second_factor == 'totp'
      ) || (
        request.auth.token.keys().hasAll(['aud', 'test_admin_mfa'])
        && request.auth.token.test_admin_mfa == true
        && request.auth.token.aud in [
          'demo-aizu-connect-admin-approval',
          'demo-aizu-connect-e2e',
          'demo-aizu-connect-a11y',
          'demo-aizu-connect-local'
        ]
      );
    }

    function isAdmin() {
      return hasActiveRole(['admin']) && hasVerifiedAdminSecondFactor();
    }

    function isActiveStudent() {
      return hasActiveRole(['student']);
    }

    function isActiveOrganization() {
      return hasActiveRole(['organization']);
    }

    function isActiveCreator() {
      return hasActiveRole(['student', 'organization']);
    }

    function isRoomMember(roomId, uid) {
      return exists(
        /databases/$(database)/documents/chatRooms/$(roomId)/members/$(uid)
      ) || (
        exists(/databases/$(database)/documents/chatRooms/$(roomId))
        && uid in get(
          /databases/$(database)/documents/chatRooms/$(roomId)
        ).data.participantIds
      );
    }

    function validString(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function validOptionalString(value, max) {
      return value == null
        || (value is string && value.size() >= 0 && value.size() <= max);
    }

    function validGrade(value) {
      return value is number && value >= 0 && value <= 6;
    }

    function validListItem(value, index, maxLength) {
      return value.size() <= index
        || validString(value[index], 1, maxLength);
    }

    function validInterests(value) {
      return value is list
        && value.size() <= 5
        && (value.size() <= 0
          || (value[0] is string && value[0].size() >= 1 && value[0].size() <= 40))
        && (value.size() <= 1
          || (value[1] is string && value[1].size() >= 1 && value[1].size() <= 40))
        && (value.size() <= 2
          || (value[2] is string && value[2].size() >= 1 && value[2].size() <= 40))
        && (value.size() <= 3
          || (value[3] is string && value[3].size() >= 1 && value[3].size() <= 40))
        && (value.size() <= 4
          || (value[4] is string && value[4].size() >= 1 && value[4].size() <= 40));
    }

    function isAizuStudentIdentity(data) {
      return request.auth.token.email == data.email
        && data.email.matches('^[^@]+@u-aizu\\.ac\\.jp$');
    }

    function isVerifiedStudentIdentity(data) {
      return request.auth.token.email_verified == true
        && request.auth.token.email == data.email;
    }

    function isVerifiedAizuStudentIdentity(data) {
      return request.auth.token.email_verified == true
        && request.auth.token.email == data.email
        && data.email.matches('^[^@]+@u-aizu\\.ac\\.jp$');
    }

    function validLegalConsent(data) {
      return data.keys().hasAll([
        'termsVersion', 'privacyVersion', 'legalAcceptedAt',
        'eligibilityConfirmedAt'
      ])
      && data.termsVersion == '2026-10-19'
      && data.privacyVersion == '2026-10-19'
      && data.legalAcceptedAt is timestamp
      && data.eligibilityConfirmedAt is timestamp;
    }

    function validUser(data, uid) {
      return data.keys().hasOnly([
        'uid', 'role', 'status', 'email', 'displayName', 'university',
        'department', 'grade', 'interests', 'organizationId',
        'organizationName', 'profileImageUrl', 'currentActivities',
        'wantToTry', 'reviewReason', 'moderationReason', 'termsVersion',
        'privacyVersion', 'legalAcceptedAt', 'eligibilityConfirmedAt',
        'createdAt', 'updatedAt'
      ])
      && data.uid == uid
      && data.role in ['student', 'organization']
      && validOptionalString(data.email, 320)
      && request.auth.token.email is string
      && data.email == request.auth.token.email
      && (!data.keys().hasAny(['profileImageUrl'])
        || validOptionalString(data.profileImageUrl, 500))
      && validString(data.displayName, 1, 80)
      && validString(data.university, 1, 80)
      && validString(data.department, 0, 80)
      && validGrade(data.grade)
      && validInterests(data.interests)
      && (!data.keys().hasAny(['currentActivities'])
        || validOptionalString(data.currentActivities, 240))
      && (!data.keys().hasAny(['wantToTry'])
        || validOptionalString(data.wantToTry, 240))
      && (!data.keys().hasAny(['reviewReason'])
        || validOptionalString(data.reviewReason, 1000))
      && (!data.keys().hasAny(['moderationReason'])
        || validOptionalString(data.moderationReason, 1000))
      && data.createdAt is timestamp
      && data.updatedAt is timestamp
      && (
        (
          data.role == 'student'
          && !data.keys().hasAny(['organizationId', 'organizationName'])
          && (
            data.status == 'pending_approval'
            || (
              data.status == 'active'
              && (
                isAizuStudentIdentity(data)
                || isVerifiedStudentIdentity(data)
              )
            )
          )
        )
        || (
          data.role == 'organization'
          && data.status == 'pending_approval'
          && data.keys().hasAll(['organizationId', 'organizationName'])
          && data.organizationId == uid
          && validString(data.organizationName, 1, 100)
        )
      );
    }

    function validStudentProfile(data, uid) {
      return data.keys().hasOnly([
        'uid', 'role', 'status', 'email', 'displayName', 'university',
        'department', 'grade', 'interests', 'verificationMethod',
        'profileCompletionRate', 'activityCount', 'currentActivities',
        'wantToTry', 'profileImageUrl', 'createdAt', 'updatedAt'
      ])
      && data.uid == uid
      && data.role == 'student'
      && data.status in ['pending_approval', 'active']
      && validOptionalString(data.email, 320)
      && request.auth.token.email is string
      && data.email == request.auth.token.email
      && (!data.keys().hasAny(['profileImageUrl'])
        || validOptionalString(data.profileImageUrl, 500))
      && validString(data.displayName, 1, 80)
      && validString(data.university, 1, 80)
      && validString(data.department, 0, 80)
      && validGrade(data.grade)
      && validInterests(data.interests)
      && (!data.keys().hasAny(['currentActivities'])
        || validOptionalString(data.currentActivities, 240))
      && (!data.keys().hasAny(['wantToTry'])
        || validOptionalString(data.wantToTry, 240))
      && validString(data.verificationMethod, 1, 40)
      && data.profileCompletionRate is number
      && data.profileCompletionRate >= 0
      && data.profileCompletionRate <= 100
      && data.activityCount is number
      && data.activityCount >= 0
      && data.createdAt is timestamp
      && data.updatedAt is timestamp
      && (
        data.status == 'pending_approval'
        || (
          data.status == 'active'
          && (
            isAizuStudentIdentity(data)
            || isVerifiedStudentIdentity(data)
          )
        )
      );
    }

    // Update validators only re-check fields that a client is permitted to
    // change. All identity and workflow fields remain immutable in the caller,
    // while these checks ensure the resulting editable profile stays valid.
    function validStudentEditableFields(data) {
      return validString(data.displayName, 1, 80)
        && validString(data.department, 0, 80)
        && validGrade(data.grade)
        && validInterests(data.interests)
        && (!data.keys().hasAny(['currentActivities'])
          || validOptionalString(data.currentActivities, 240))
        && (!data.keys().hasAny(['wantToTry'])
          || validOptionalString(data.wantToTry, 240))
        && (!data.keys().hasAny(['profileImageUrl'])
          || validOptionalString(data.profileImageUrl, 500))
        && data.updatedAt is timestamp;
    }

    function validUserUpdate(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let isOwner = signedIn() && request.auth.uid == userId;
      let isStudentOwner = isOwner && resource.data.role == 'student';
      return (
          changed.hasOnly([
            'status', 'reviewReason', 'moderationReason', 'updatedAt'
          ])
          && signedIn()
          && request.auth.uid != userId
          && isAdmin()
          && request.resource.data.role == resource.data.role
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.status in ['active', 'rejected', 'suspended']
          && request.resource.data.updatedAt is timestamp
        )
        || (
          changed.hasOnly([
            'displayName', 'department', 'grade', 'interests',
            'currentActivities', 'wantToTry', 'profileImageUrl', 'updatedAt'
          ])
          && isStudentOwner
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
          && validStudentEditableFields(request.resource.data)
        )
        || (
          changed.hasOnly(['status', 'updatedAt'])
          && isStudentOwner
          && resource.data.status == 'pending_approval'
          && request.resource.data.role == resource.data.role
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.status == 'active'
          && isVerifiedAizuStudentIdentity(request.resource.data)
          && request.resource.data.updatedAt is timestamp
        )
        || (
          changed.hasOnly([
            'termsVersion', 'privacyVersion', 'legalAcceptedAt',
            'eligibilityConfirmedAt', 'updatedAt'
          ])
          && isOwner
          && resource.data.role in ['student', 'organization']
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
          && validLegalConsent(request.resource.data)
          && request.resource.data.legalAcceptedAt == request.time
          && request.resource.data.eligibilityConfirmedAt == request.time
          && request.resource.data.updatedAt == request.time
        );
    }

    function validStudentProfileUpdate(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let isOwner = signedIn() && request.auth.uid == userId;
      return (
          changed.hasOnly([
            'displayName', 'department', 'grade', 'interests',
            'currentActivities', 'wantToTry', 'profileImageUrl', 'updatedAt'
          ])
          && isOwner
          && request.resource.data.status == resource.data.status
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && validStudentEditableFields(request.resource.data)
        )
        || (
          changed.hasOnly(['status', 'updatedAt'])
          && isOwner
          && resource.data.role == 'student'
          && resource.data.status == 'pending_approval'
          && request.resource.data.role == resource.data.role
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.status == 'active'
          && isVerifiedAizuStudentIdentity(request.resource.data)
          && request.resource.data.updatedAt is timestamp
        );
    }

    function attendanceWindowOpen(eventId) {
      let event = get(
        /databases/$(database)/documents/events/$(eventId)
      );
      return event.data.startAt is timestamp
        && request.time >= event.data.startAt - duration.value(3, 'h');
    }

    function validOrganization(data, organizationId) {
      return data.keys().hasOnly([
        'id', 'displayName', 'description', 'contactEmail', 'status',
        'createdBy', 'createdAt', 'updatedAt'
      ])
      && data.id == organizationId
      && data.createdBy == organizationId
      && data.status in ['pending_approval', 'active', 'rejected', 'suspended']
      && validString(data.displayName, 1, 100)
      && validOptionalString(data.description, 1000)
      && validOptionalString(data.contactEmail, 320)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if signedIn()
        && request.auth.uid == userId
        && validUser(request.resource.data, userId)
        && (
          request.resource.data.status == 'pending_approval'
          || (
            request.resource.data.role == 'student'
            && request.resource.data.status == 'active'
            && isAizuStudentIdentity(request.resource.data)
          )
        )
        && validLegalConsent(request.resource.data);
      allow update: if validUserUpdate(userId);
      allow delete: if false;
    }

    match /legalConsents/{consentId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && consentId == request.auth.uid + '_2026-10-19_2026-10-19'
        && request.resource.data.keys().hasOnly([
          'userId', 'termsVersion', 'privacyVersion', 'acceptedAt',
          'eligibilityConfirmedAt', 'source'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.termsVersion == '2026-10-19'
        && request.resource.data.privacyVersion == '2026-10-19'
        && request.resource.data.acceptedAt == request.time
        && request.resource.data.eligibilityConfirmedAt == request.time
        && request.resource.data.source in ['registration', 'reconsent'];
      allow update, delete: if false;
    }

    match /studentProfiles/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if signedIn()
        && request.auth.uid == userId
        && (
          request.resource.data.status == 'pending_approval'
          || (
            request.resource.data.status == 'active'
            && isAizuStudentIdentity(request.resource.data)
          )
        )
        && validStudentProfile(request.resource.data, userId);
      allow update: if validStudentProfileUpdate(userId);
      allow delete: if false;
    }

    match /organizations/{organizationId} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == organizationId);
      allow create: if signedIn()
        && request.auth.uid == organizationId
        && validOrganization(request.resource.data, organizationId)
        && request.resource.data.status == 'pending_approval'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt'
        ])
        && request.resource.data.status in ['active', 'rejected', 'suspended']
        && request.resource.data.updatedAt is timestamp
        || (isActiveOrganization()
          && request.auth.uid == organizationId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'description', 'contactEmail', 'updatedAt'
          ])
          && validOrganization(request.resource.data, organizationId)
          && request.resource.data.status == resource.data.status
          && request.resource.data.updatedAt is timestamp);
      allow delete: if false;
    }

    match /accountDeletionRequests/{userId} {
      function validDeletionRequest(data) {
        return data.keys().hasOnly([
          'userId', 'status', 'reason', 'requestedAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'userId', 'status', 'reason', 'requestedAt', 'updatedAt'
        ])
        && data.userId == userId
        && data.status in ['submitted', 'cancelled']
        && validString(data.reason, 5, 500)
        && data.requestedAt is timestamp
        && data.updatedAt is timestamp;
      }

      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == userId);
      allow create: if isActiveCreator()
        && request.auth.uid == userId
        && validDeletionRequest(request.resource.data)
        && request.resource.data.status == 'submitted'
        && request.resource.data.requestedAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isActiveCreator()
        && request.auth.uid == userId
        && validDeletionRequest(request.resource.data)
        && request.resource.data.updatedAt == request.time
        && (
          (
            resource.data.status == 'submitted'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.reason == resource.data.reason
            && request.resource.data.requestedAt == resource.data.requestedAt
          )
          || (
            resource.data.status == 'cancelled'
            && request.resource.data.status == 'submitted'
            && request.resource.data.requestedAt == request.time
          )
        );
      allow delete: if false;
    }

    match /events/{eventId} {
      allow read: if isAdmin()
        || (isActiveStudent() && resource.data.status == 'published')
        || (isActiveCreator() && resource.data.createdBy == request.auth.uid);
      allow create: if false;
      allow update: if (
          isAdmin()
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'revisionReason', 'reviewNote', 'reviewedBy',
            'reviewedAt', 'moderationReason', 'updatedAt'
          ])
          && (
            (
              resource.data.status == 'pending_review'
              && request.resource.data.status in [
                'published', 'revision_required'
              ]
            )
            || (
              resource.data.status == 'published'
              && request.resource.data.status == 'unpublished'
            )
            || (
              resource.data.status == 'unpublished'
              && request.resource.data.status == 'published'
            )
          )
          && request.resource.data.updatedAt is timestamp
          && (!request.resource.data.keys().hasAny(['revisionReason'])
            || validOptionalString(request.resource.data.revisionReason, 1000))
          && (!request.resource.data.keys().hasAny(['reviewNote'])
            || validOptionalString(request.resource.data.reviewNote, 1000))
          && (!request.resource.data.keys().hasAny(['reviewedBy'])
            || validOptionalString(request.resource.data.reviewedBy, 128))
          && (!request.resource.data.keys().hasAny(['reviewedAt'])
            || request.resource.data.reviewedAt is timestamp)
          && (!request.resource.data.keys().hasAny(['moderationReason'])
            || validOptionalString(request.resource.data.moderationReason, 1000))
        ) || (
          isActiveCreator()
          && resource.data.createdBy == request.auth.uid
          && resource.data.status in [
            'published', 'pending_review', 'revision_required'
          ]
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'cancellationReason', 'cancelledAt', 'updatedAt'
          ])
          && validString(request.resource.data.cancellationReason, 1, 500)
          && request.resource.data.cancelledAt is timestamp
          && request.resource.data.updatedAt is timestamp
        );
      allow delete: if false;
    }

    match /eventApplications/{applicationId} {
      allow read: if isAdmin()
        || (isActiveStudent() && resource.data.studentId == request.auth.uid)
        || (isActiveCreator() && resource.data.organizationId == request.auth.uid);
      allow create: if false;
      allow update: if isActiveCreator()
        && resource.data.organizationId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'organizerNote'
        ])
        && (!request.resource.data.keys().hasAny(['organizerNote'])
          || validOptionalString(request.resource.data.organizerNote, 500))
        && (
          (
            resource.data.status == 'pending'
            && request.resource.data.status in ['confirmed', 'rejected']
          )
          || (
            resource.data.status == 'confirmed'
            && request.resource.data.status in ['attended', 'absent']
            && attendanceWindowOpen(resource.data.eventId)
          )
          || (
            resource.data.status == 'waitlisted'
            && request.resource.data.status == 'rejected'
          )
          || request.resource.data.status == resource.data.status
        )
        || (isActiveStudent()
          && resource.data.studentId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'cancellationReason', 'cancelledAt'
          ])
          && resource.data.status in ['pending', 'waitlisted', 'confirmed']
          && request.resource.data.status == 'cancelled'
          && validString(request.resource.data.cancellationReason, 1, 500)
          && request.resource.data.cancelledAt is timestamp
          && (
            !get(
              /databases/$(database)/documents/events/$(resource.data.eventId)
            ).data.keys().hasAny(['cancellationDeadline'])
            || request.time <= get(
              /databases/$(database)/documents/events/$(resource.data.eventId)
            ).data.cancellationDeadline
          ));
      allow delete: if false;
    }

    match /chatRooms/{roomId} {
      function roomEvent() {
        return get(/databases/$(database)/documents/events/$(resource.data.eventId));
      }

      allow get: if isActiveCreator()
        && (
          exists(
            /databases/$(database)/documents/chatRooms/$(roomId)/members/$(request.auth.uid)
          )
          || (
            resource.data.keys().hasAny(['participantIds'])
            && (request.auth.uid in resource.data.participantIds)
          )
        );
      allow list: if isActiveCreator()
        && (request.auth.uid in resource.data.participantIds);
      allow create: if false;
      allow update: if isActiveCreator()
        && (
          exists(
            /databases/$(database)/documents/chatRooms/$(roomId)/members/$(request.auth.uid)
          )
          || (
            resource.data.keys().hasAny(['participantIds'])
            && (request.auth.uid in resource.data.participantIds)
          )
        )
        && resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessageText', 'lastMessageAt'
        ])
        && validString(request.resource.data.lastMessageText, 1, 2000)
        && request.resource.data.lastMessageAt is timestamp
        || (
          isActiveCreator()
          && roomEvent().data.createdBy == request.auth.uid
          && resource.data.roomType == 'event'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'pinnedMessage', 'organizerNotice', 'updatedAt'
          ])
          && validOptionalString(request.resource.data.pinnedMessage, 180)
          && validOptionalString(request.resource.data.organizerNotice, 220)
          && request.resource.data.updatedAt is timestamp
        );
      allow delete: if false;

      match /members/{memberId} {
        allow read: if isActiveCreator()
          && resource.data.userId == request.auth.uid;
        allow write: if false;
      }

      match /messages/{messageId} {
        allow read: if isActiveCreator()
          && isRoomMember(roomId, request.auth.uid);
        allow create: if isActiveCreator()
          && isRoomMember(roomId, request.auth.uid)
          && get(
            /databases/$(database)/documents/chatRooms/$(roomId)
          ).data.status == 'active'
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName == userData().displayName
          && request.resource.data.roomId == roomId
          && validString(request.resource.data.text, 1, 2000)
          && validString(request.resource.data.senderName, 1, 80)
          && (
            (
              request.resource.data.type == 'text'
              && request.resource.data.keys().hasOnly([
                'roomId', 'senderId', 'senderName', 'type', 'text', 'createdAt'
              ])
            )
            || (
              request.resource.data.type in ['image', 'file']
              && request.resource.data.keys().hasOnly([
                'roomId', 'senderId', 'senderName', 'type', 'text',
                'attachmentUrl', 'attachmentName', 'attachmentType',
                'attachmentSize', 'createdAt'
              ])
              && validString(request.resource.data.attachmentUrl, 1, 1000)
              && validString(request.resource.data.attachmentName, 1, 200)
              && validString(request.resource.data.attachmentType, 1, 100)
              && request.resource.data.attachmentSize is number
              && request.resource.data.attachmentSize >= 0
              && request.resource.data.attachmentSize < 10 * 1024 * 1024
            )
          )
          && request.resource.data.createdAt is timestamp;
        allow update: if false;
        allow delete: if false;
      }

      match /reads/{userId} {
        allow read: if isActiveCreator()
          && isRoomMember(roomId, request.auth.uid);
        allow create, update: if isActiveCreator()
          && request.auth.uid == userId
          && isRoomMember(roomId, request.auth.uid)
          && request.resource.data.keys().hasOnly(['userId', 'readAt'])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.readAt is timestamp;
        allow delete: if false;
      }
    }

    match /activities/{activityId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid)
        || (isActiveOrganization() && resource.data.organizationId == request.auth.uid);
      allow create: if false;
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.recipientId == request.auth.uid);
      allow update: if signedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isRead', 'readAt'
        ])
        && request.resource.data.isRead is bool
        && (!request.resource.data.keys().hasAny(['readAt'])
          || request.resource.data.readAt is timestamp);
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'recipientId', 'type', 'title', 'body', 'targetType', 'targetId',
          'isRead', 'createdAt'
        ])
        && validString(request.resource.data.recipientId, 1, 128)
        && validString(request.resource.data.type, 1, 80)
        && validString(request.resource.data.title, 1, 160)
        && validString(request.resource.data.body, 1, 1000)
        && validString(request.resource.data.targetType, 1, 80)
        && validString(request.resource.data.targetId, 1, 200)
        && request.resource.data.isRead == false
        && request.resource.data.createdAt is timestamp;
      allow delete: if false;
    }

    match /notificationPreferences/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'userId', 'newEvents', 'applicationUpdates', 'chatMessages',
          'eventReminders', 'updatedAt'
        ])
        && request.resource.data.userId == userId
        && request.resource.data.newEvents is bool
        && request.resource.data.applicationUpdates is bool
        && request.resource.data.chatMessages is bool
        && request.resource.data.eventReminders is bool
        && (!request.resource.data.keys().hasAny(['updatedAt'])
          || request.resource.data.updatedAt is timestamp);
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'newEvents', 'applicationUpdates', 'chatMessages',
          'eventReminders', 'updatedAt'
        ])
        && request.resource.data.newEvents is bool
        && request.resource.data.applicationUpdates is bool
        && request.resource.data.chatMessages is bool
        && request.resource.data.eventReminders is bool
        && (!request.resource.data.keys().hasAny(['updatedAt'])
          || request.resource.data.updatedAt is timestamp);
      allow delete: if false;
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'reporterId', 'targetType', 'targetId', 'targetTitle', 'reason',
          'description', 'status', 'createdAt'
        ])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.targetType in ['event', 'message']
        && request.resource.data.reason in [
          '不適切な内容', '迷惑行為・スパム', '個人情報が含まれている',
          '詐欺・危険な勧誘', 'その他'
        ]
        && validString(request.resource.data.targetId, 1, 200)
        && validString(request.resource.data.targetTitle, 1, 200)
        && validOptionalString(request.resource.data.description, 1000)
        && request.resource.data.createdAt is timestamp;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'resolution', 'resolvedAt'
        ])
        && request.resource.data.status in ['resolved', 'dismissed']
        && (!request.resource.data.keys().hasAny(['resolution'])
          || validOptionalString(request.resource.data.resolution, 1000))
        && (!request.resource.data.keys().hasAny(['resolvedAt'])
          || request.resource.data.resolvedAt is timestamp);
      allow delete: if false;
    }

    match /savedEvents/{savedEventId} {
      allow read: if isActiveStudent()
        && resource.data.userId == request.auth.uid;
      allow create: if isActiveStudent()
        && request.resource.data.keys().hasOnly([
          'userId', 'eventId', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.eventId is string
        && request.resource.data.eventId.size() >= 1
        && request.resource.data.eventId.size() <= 200
        && (!request.resource.data.keys().hasAny(['createdAt'])
          || request.resource.data.createdAt is timestamp);
      allow delete: if isActiveStudent()
        && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /savedSearches/{savedSearchId} {
      allow read: if isActiveStudent()
        && resource.data.userId == request.auth.uid;
      allow create, update: if isActiveStudent()
        && savedSearchId.matches('^' + request.auth.uid + '_.*$')
        && request.resource.data.keys().hasOnly([
          'userId', 'name', 'searchText', 'category', 'dateFilter', 'dayFilter',
          'timeFilter', 'feeFilter', 'formatFilter', 'onlyAvailable',
          'onlyBeginner', 'updatedAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && validString(request.resource.data.name, 1, 60)
        && validOptionalString(request.resource.data.searchText, 120)
        && validString(request.resource.data.category, 1, 40)
        && request.resource.data.dateFilter in ['すべて', '今週', '今月']
        && request.resource.data.dayFilter in ['すべて', '平日', '土日']
        && request.resource.data.timeFilter in ['すべて', '午前', '午後', '夜']
        && request.resource.data.feeFilter in ['すべて', '無料', '有料']
        && request.resource.data.formatFilter in [
          'すべて', '現地', 'オンライン', 'ハイブリッド'
        ]
        && request.resource.data.onlyAvailable is bool
        && request.resource.data.onlyBeginner is bool
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isActiveStudent()
        && resource.data.userId == request.auth.uid;
    }

    match /chatPreferences/{preferenceId} {
      allow read: if isActiveCreator()
        && resource.data.userId == request.auth.uid;
      allow create, update: if isActiveCreator()
        && preferenceId == request.resource.data.roomId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId', 'roomId', 'muted', 'updatedAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && validString(request.resource.data.roomId, 1, 200)
        && request.resource.data.muted is bool
        && request.resource.data.updatedAt is timestamp
        && isRoomMember(request.resource.data.roomId, request.auth.uid);
      allow delete: if isActiveCreator()
        && resource.data.userId == request.auth.uid;
    }

    match /publicOrganizerProfiles/{userId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /savedOrganizers/{savedOrganizerId} {
      allow read: if isActiveStudent()
        && resource.data.userId == request.auth.uid;
      allow create: if isActiveStudent()
        && savedOrganizerId == request.auth.uid + '_' + request.resource.data.organizationId
        && request.resource.data.keys().hasOnly([
          'userId', 'organizationId', 'organizationName', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && validString(request.resource.data.organizationId, 1, 128)
        && validString(request.resource.data.organizationName, 1, 100)
        && request.resource.data.createdAt is timestamp;
      allow delete: if isActiveStudent()
        && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /userBlocks/{blockId} {
      allow read: if isActiveCreator()
        && resource.data.blockerId == request.auth.uid;
      allow create: if isActiveCreator()
        && blockId == request.auth.uid + '_' + request.resource.data.blockedId
        && request.resource.data.keys().hasOnly([
          'blockerId', 'blockedId', 'reason', 'createdAt'
        ])
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedId != request.auth.uid
        && validString(request.resource.data.blockedId, 1, 128)
        && validOptionalString(request.resource.data.reason, 300)
        && request.resource.data.createdAt is timestamp;
      allow delete: if isActiveCreator()
        && resource.data.blockerId == request.auth.uid;
      allow update: if false;
    }

    match /eventSurveys/{eventId}/responses/{userId} {
      allow read: if isAdmin()
        || (isActiveStudent() && request.auth.uid == userId)
        || (isActiveOrganization()
          && get(/databases/$(database)/documents/events/$(eventId)).data.createdBy
            == request.auth.uid);
      allow create, update: if isActiveStudent()
        && request.auth.uid == userId
        && exists(
          /databases/$(database)/documents/eventApplications/$(eventId + '_' + userId)
        )
        && get(
          /databases/$(database)/documents/eventApplications/$(eventId + '_' + userId)
        ).data.status == 'attended'
        && request.resource.data.keys().hasOnly([
          'eventId', 'userId', 'rating', 'comment', 'wouldRecommend',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.eventId == eventId
        && request.resource.data.userId == userId
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && validOptionalString(request.resource.data.comment, 1000)
        && request.resource.data.wouldRecommend is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    match /eventReports/{eventId} {
      allow read: if isAdmin()
        || (signedIn()
          && resource != null
          && resource.data.status == 'published')
        || (isActiveOrganization()
          && resource != null
          && resource.data.organizationId == request.auth.uid);
      allow create, update: if isActiveOrganization()
        && get(/databases/$(database)/documents/events/$(eventId)).data.createdBy
          == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'eventId', 'organizationId', 'title', 'summary', 'imageUrls',
          'participantCount', 'status', 'rightsConfirmed', 'createdAt',
          'updatedAt', 'publishedAt'
        ])
        && request.resource.data.eventId == eventId
        && request.resource.data.organizationId == request.auth.uid
        && validString(request.resource.data.title, 1, 160)
        && validString(request.resource.data.summary, 1, 2000)
        && request.resource.data.imageUrls is list
        && request.resource.data.imageUrls.size() <= 4
        && validListItem(request.resource.data.imageUrls, 0, 1000)
        && validListItem(request.resource.data.imageUrls, 1, 1000)
        && validListItem(request.resource.data.imageUrls, 2, 1000)
        && validListItem(request.resource.data.imageUrls, 3, 1000)
        && request.resource.data.participantCount is int
        && request.resource.data.participantCount >= 0
        && request.resource.data.status in ['draft', 'published']
        && request.resource.data.rightsConfirmed == true
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (!request.resource.data.keys().hasAny(['publishedAt'])
          || request.resource.data.publishedAt is timestamp);
      allow delete: if false;
    }

    match /adminAssignments/{assignmentId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'targetType', 'targetId', 'assigneeId', 'assigneeName', 'dueAt',
          'status', 'updatedAt'
        ])
        && request.resource.data.targetType in ['event', 'user', 'report', 'deletion']
        && validString(request.resource.data.targetId, 1, 200)
        && request.resource.data.assigneeId == request.auth.uid
        && validString(request.resource.data.assigneeName, 1, 80)
        && request.resource.data.status in ['open', 'in_progress', 'completed']
        && request.resource.data.updatedAt is timestamp
        && (!request.resource.data.keys().hasAny(['dueAt'])
          || request.resource.data.dueAt is timestamp);
      allow delete: if false;
    }

    match /thirdPartyProvisionLogs/{logId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /auditLogs/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'actorId', 'actorName', 'action', 'targetType', 'targetId',
          'targetTitle', 'reason', 'createdAt'
        ])
        && request.resource.data.actorId == request.auth.uid
        && validString(request.resource.data.actorName, 1, 80)
        && validString(request.resource.data.action, 1, 80)
        && request.resource.data.targetType in ['event', 'user', 'report']
        && validString(request.resource.data.targetId, 1, 200)
        && validString(request.resource.data.targetTitle, 1, 200)
        && validString(request.resource.data.reason, 1, 1000)
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    match /eventCheckIns/{eventId} {
      allow read: if isAdmin()
        || (isActiveCreator()
          && resource.data.organizerId == request.auth.uid);
      allow write: if false;
    }

    // Collection-group queries need an explicit recursive match. Membership
    // documents contain only the signed-in user's own membership metadata.
    match /{path=**}/members/{memberId} {
      allow read: if isActiveCreator()
        && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
