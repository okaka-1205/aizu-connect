{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "firestore": {
    "database": "(default)",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 19099
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 15001
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 18082,
      "websocketPort": 19152
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 19197
    },
    "hub": {
      "host": "127.0.0.1",
      "port": 14402
    },
    "logging": {
      "host": "127.0.0.1",
      "port": 14502
    },
    "ui": {
      "enabled": false
    }
  }
}
